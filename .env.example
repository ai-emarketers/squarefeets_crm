# Environment variables. Copy this file to apps/api/.env (API) and apps/web/.env.local (web) and edit the values.
# Never commit the real .env files — .gitignore already excludes them.
# DATABASE_URL: PostgreSQL connection string (matches docker-compose.yml for local dev).
DATABASE_URL="postgresql://squarefeets:squarefeets@localhost:5432/squarefeets_crm?schema=public"
# JWT_SECRET: signs login tokens. MUST be a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"
# JWT_EXPIRES_IN: how long a login stays valid (e.g. 7d, 12h).
JWT_EXPIRES_IN="7d"
# API_PORT: port the NestJS API listens on.
API_PORT=4000
# WEB_ORIGIN: address of the web app, allowed by CORS.
WEB_ORIGIN="http://localhost:3000"
# UPLOAD_DIR: folder where uploaded documents are stored on disk.
UPLOAD_DIR="./uploads"
# SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD: owner login created by `npm run db:seed`. Change the password after first login.
SEED_ADMIN_EMAIL="anil@sharmaproperty.in"
SEED_ADMIN_PASSWORD="ChangeMe@123"
# --- web app ---
# NEXT_PUBLIC_API_URL: keep "/api" (the website forwards it to the API). API_INTERNAL_URL: where the website reaches the API.
NEXT_PUBLIC_API_URL="/api"
API_INTERNAL_URL="http://localhost:4000"
# --- email (optional): matched-properties emails go out through Brevo (free plan: 300 emails a day) ---
# BREVO_API_KEY: create one in Brevo -> SMTP & API -> API keys. MAIL_FROM_EMAIL: a sender you verified in Brevo (Senders & IP).
# MAIL_FROM_NAME / MAIL_ORG_ADDRESS: optional display name and the address line shown in the email footer.
BREVO_API_KEY=""
MAIL_FROM_EMAIL=""
MAIL_FROM_NAME="SquareFeets Realty"
MAIL_ORG_ADDRESS=""
# --- OR send through Gmail / any SMTP mailbox with TLS on port 465 (SMTP wins when both are set) ---
# Gmail: turn on 2-step verification, then create an "App password" at myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_USER=""
SMTP_PASS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
