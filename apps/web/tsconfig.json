// TypeScript settings for the Next.js app (comments are allowed in tsconfig).
{
  "compilerOptions": {
    // JS version emitted/assumed
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    // strict off: the ported UI engine is loosely typed on purpose
    "strict": false,
    // Next.js compiles; tsc is only used for type checking
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // "@/lib/api" means "src/lib/api"
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
