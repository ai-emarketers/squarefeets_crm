# Copy to apps/web/.env.local
# NEXT_PUBLIC_API_URL: where the BROWSER sends API calls. Keep "/api" (same address as the website); Next.js
#   forwards those calls to API_INTERNAL_URL. Only change it if the API lives on a separate public address.
NEXT_PUBLIC_API_URL="/api"
# API_INTERNAL_URL: where the Next.js server reaches the NestJS API (no /api at the end).
API_INTERNAL_URL="http://localhost:4000"
